# ---- Backend ----
# Comma-separated key pool, at least 2 keys. Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# LiteLLM model name used for every key. Verify with `make check-keys` (Google retires models; 2.0-flash is gone)
LLM_MODEL=gemini/gemini-3.5-flash-lite
# SQLite location (inside the Docker volume). Without Docker use sqlite:///./app.db
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (the frontend URL(s))
ALLOWED_ORIGINS=http://localhost:3000
# Enables the X-Simulate-Failure test hook. Must be true on the deployed backend.
ENABLE_FAILURE_SIMULATION=true
# LiteLLM cache: "disk" (persists in /data/cache) or "local" (in-memory)
CACHE_TYPE=disk
# CACHE_DIR defaults to a "cache" folder next to the SQLite file
CACHE_DIR=
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
REQUEST_TIMEOUT_SECONDS=20
# Cap on reply length (thinking tokens also count toward this on Gemini, so don't go too low)
MAX_TOKENS=1024
# Thinking amount: minimal | low | medium | high | disable. Lower = faster. Empty = model default
REASONING_EFFORT=low
MAX_HISTORY_MESSAGES=50

# ---- Frontend ----
# Public URL of the backend as seen by the browser (runtime for Docker, build-time VITE_API_URL on Vercel/Netlify)
API_URL=http://localhost:8000